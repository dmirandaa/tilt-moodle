# =============================================================================
# Moodle Stack — Environment Variables
# =============================================================================
# Copy this file to .env before running `tilt up` and adjust values as needed.
# Passwords shown here are defaults suitable for local development ONLY.
# =============================================================================

# ── PHP / Moodle build ──────────────────────────────────────────────────────
# PHP version for the Moodle container image.
#   Supported: 7.4 | 8.0 | 8.1 | 8.2 | 8.3
PHP_VERSION=7.4

# Moodle Git branch to clone during image build.
#   PHP 7.4 → MOODLE_401_STABLE  (Moodle 4.1, last release supporting PHP 7.4)
#   PHP 8.x → MOODLE_403_STABLE  (Moodle 4.3, recommended)
MOODLE_BRANCH=MOODLE_38_STABLE

# ── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=moodlepassword
POSTGRES_PORT=5432

# ── Moodle application ──────────────────────────────────────────────────────
# Database backend: mysqli (MySQL) or pgsql (PostgreSQL)
MOODLE_DB_TYPE=pgsql
MOODLE_DB_HOST=postgres
MOODLE_DB_PORT=5432
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=moodlepassword
MOODLE_DB_PREFIX=mdl_

# Moodle web root — must match the URL used to access the site
MOODLE_PORT=8080
MOODLE_HTTPS_PORT=8443
MOODLE_WWWROOT=https://localhost:8443

# Moodle admin account (created on first install)
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=password!
MOODLE_ADMIN_EMAIL=admin@example.com

# Site identity
MOODLE_SITE_NAME=Moodle LMS 3.8
MOODLE_SITE_SHORTNAME=moodle

# ── phpMyAdmin ──────────────────────────────────────────────────────────────
PHPMYADMIN_PORT=8081

# ── pgAdmin ─────────────────────────────────────────────────────────────────
PGADMIN_PORT=8082
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=adminpassword
