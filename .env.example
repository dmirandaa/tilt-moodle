# =============================================================================
# Moodle Stack — Environment Variables
# =============================================================================
# Copy this file to .env before running `tilt up` and adjust values as needed.
# Passwords shown here are defaults suitable for local development ONLY.
# =============================================================================

# ── Moodle image builds (Tilt / Kubernetes) ────────────────────────────────
MOODLE38_PHP_VERSION=7.4
MOODLE38_BRANCH=MOODLE_38_STABLE
MOODLE45_PHP_VERSION=8.2
MOODLE45_BRANCH=MOODLE_405_STABLE
MOODLE52_PHP_VERSION=8.3
MOODLE52_BRANCH=MOODLE_502_STABLE

# ── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306
K8S_MYSQL_HOST=mysql-service
K8S_MYSQL_PORT=3306

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=postgres
POSTGRES_USER=moodle
POSTGRES_PASSWORD=moodlepassword
POSTGRES_PORT=5432
K8S_POSTGRES_HOST=postgres-service
K8S_POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
K8S_REDIS_HOST=redis-service
K8S_REDIS_PORT=6379
MOODLE_REDIS_SESSION=false

# ── Shared Moodle application settings ──────────────────────────────────────
# Database backend: mysqli (MySQL) or pgsql (PostgreSQL)
MOODLE_DB_TYPE=mysqli
MOODLE_DB_HOST=mysql
K8S_MOODLE_DB_HOST=mysql-service
MOODLE_DB_PORT=3306
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=moodlepassword
MOODLE_DB_PREFIX=mdl_

# Moodle admin account (created on first install)
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=password!
MOODLE_ADMIN_EMAIL=admin@example.com

# ── Moodle 3.8 ──────────────────────────────────────────────────────────────
MOODLE38_DB_NAME=moodle38
MOODLE38_PORT=8080
MOODLE38_HTTPS_PORT=8443
MOODLE38_WWWROOT=https://localhost:8443
MOODLE38_SITE_NAME="Moodle 3.8"
MOODLE38_SITE_SHORTNAME=moodle38
MOODLE38_SESSION_COOKIE_NAME=MOODLE38SESSID

# ── Moodle 4.5 ──────────────────────────────────────────────────────────────
MOODLE45_DB_NAME=moodle45
MOODLE45_PORT=8090
MOODLE45_HTTPS_PORT=8453
MOODLE45_WWWROOT=https://localhost:8453
MOODLE45_SITE_NAME="Moodle 4.5"
MOODLE45_SITE_SHORTNAME=moodle45
MOODLE45_SESSION_COOKIE_NAME=MOODLE45SESSID

# ── Moodle 5.2 ──────────────────────────────────────────────────────────────
MOODLE52_DB_NAME=moodle52
MOODLE52_PORT=8091
MOODLE52_HTTPS_PORT=8454
MOODLE52_WWWROOT=https://localhost:8454
MOODLE52_SITE_NAME="Moodle 5.2"
MOODLE52_SITE_SHORTNAME=moodle52
MOODLE52_SESSION_COOKIE_NAME=MOODLE52SESSID

# ── phpMyAdmin ──────────────────────────────────────────────────────────────
PHPMYADMIN_PORT=8081

# ── pgAdmin ─────────────────────────────────────────────────────────────────
PGADMIN_PORT=8082
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=adminpassword
